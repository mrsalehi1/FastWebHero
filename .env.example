# Region where the bucket lives. This must match the bucket.
AWS_REGION=us-east-1

# Dedicated bucket for this site. Deploy replaces removed files in this bucket.
S3_BUCKET=your-site-bucket

# Create the bucket when it does not already exist.
S3_CREATE_BUCKET=false

# Turn on S3 static website hosting and allow public reads of objects.
# The website endpoint speaks HTTP only. Use CloudFront when you need HTTPS.
S3_PUBLIC_WEBSITE=true

# Delete bucket objects that are not part of the latest build.
S3_DELETE_REMOVED=true

# Optional. Leave these unset to use an AWS profile, SSO, or an instance role.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
