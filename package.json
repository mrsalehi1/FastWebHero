{
  "name": "static-website-builder",
  "version": "1.0.0",
  "private": true,
  "description": "Build a static website with TypeScript and host it from an Amazon S3 bucket.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx src/cli.ts build",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx src/cli.ts dev",
    "preview": "tsx src/cli.ts preview",
    "deploy": "tsx src/cli.ts deploy",
    "publish": "tsx src/cli.ts publish",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.687.0",
    "dotenv": "^16.4.7",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
